/* New 3D effect classes */
.transform {
  transform: translateZ(0);
}

.transition-transform {
  transition-property: transform;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  transition-duration: 150ms;
}

.hover-scale-105:hover {
  transform: scale(1.05);
}

/* Notification badge enhancement styles */
.text-center.mt-6.space-y-2 > view {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  border: 2px solid #cccccc; /* 使用黑白灰配色方案的边框色 */
}

.text-center.mt-6.space-y-2 > view:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
  border-color: #000000; /* 黑色边框 */
}

/* Add subtle glow effect */
.text-center.mt-6.space-y-2 > view::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 9999px;
  box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.1);
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.text-center.mt-6.space-y-2 > view:hover::before {
  opacity: 1;
}

