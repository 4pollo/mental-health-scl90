/* Loading spinner animation */
.animate-spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* Border transparent class for spinner */
.border-t-transparent {
  border-top-color: transparent;
}