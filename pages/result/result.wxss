/* Ensure restart test button takes full width */
.mt-6 button.w-full {
  width: 100% !important;
  max-width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Ensure button container takes full width */
.mt-6 {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 表格显示相关样式 */
.grid {
  display: grid;
}

.grid-cols-4 {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.gap-2 {
  gap: 0.5rem;
}

.divide-y > view + view {
  border-top-width: 1px;
  border-top-style: solid;
}

.divide-gray-200 > view + view {
  border-top-color: #e0e0e0;
}

