}

.bg-red-300 {
  background-color: #000000; /* 黑色 */
}

.bg-red-400 {
  background-color: #000000; /* 黑色 */
}

/* Text colors */
.text-foreground {
  color: #000000; /* 黑色文字 */
}

.text-muted-foreground {
  color: #666666; /* 中等灰色文字 */
}

.text-white {
  color: #ffffff;
}

.text-black {
  color: #000000; /* 黑色 */
}

.text-gray-500 {
  color: #666666; /* 中等灰色 */
}

.text-white-90 {
  color: rgba(255, 255, 255, 0.9);
}

.text-center {
  text-align: center;
}

/* Border colors */
.border-2 {
  border-width: 2rpx;
  border-style: solid;
}

.border-3 {
  border-width: 3rpx;
  border-style: solid;
}

.border-b-2 {
  border-bottom-width: 2rpx;
  border-bottom-style: solid;
}

.border-blue-50 {
  border-color: #f5f5f5; /* 浅灰色边框 */
}

.border-blue-100 {
  border-color: #e0e0e0; /* 中等浅灰色边框 */
}

.border-blue-200 {
  border-color: #cccccc; /* 中等灰色边框 */
}

.border-3b82f6 {
  border-color: #000000; /* 黑色边框 */
}

.border-black {
  border-color: #000000; /* 黑色边框 */
}

.border-gray-100 {
  border-color: #f5f5f5; /* 浅灰色边框 */
}

.border-gray-200 {
  border-color: #e0e0e0; /* 中等浅灰色边框 */
}

.border-gray-300 {
  border-color: #cccccc; /* 中等灰色边框 */
}

/* Hover states */
.hover-bg-blue-600:hover {
  background-color: #000000; /* 黑色 */
}

.hover-bg-emerald-600:hover {
  background-color: #000000;
}

.hover-bg-blue-100:hover {
  background-color: #e0e0e0; /* 中等浅灰色 */
}

.hover-bg-black:hover {
  background-color: #000000; /* 黑色 */
}

.hover-border-blue-500:hover {
  border-color: #000000; /* 黑色 */
}

.hover-border-black:hover {
  border-color: #000000; /* 黑色 */
}

.hover-scale-105:hover {
  transform: scale(1.05);
}

/* Transitions */
.transition-colors {
  transition-property: background-color, border-color, color, fill, stroke;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  transition-duration: 200ms;
}

.transition-transform {
  transition-property: transform;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  transition-duration: 200ms;
}

/* Transforms */
.transform {
  transform: translateZ(0);
}

.hover-scale-105:hover {
  transform: scale(1.05);
}

/* Shadows - 黑白灰配色的阴影 */
.shadow-lg {
  box-shadow: 0 10rpx 15rpx -3rpx rgba(0, 0, 0, 0.1), 0 4rpx 6rpx -2rpx rgba(0, 0, 0, 0.05);
}

.shadow-md {
  box-shadow: 0 4rpx 6rpx -1rpx rgba(0, 0, 0, 0.1), 0 2rpx 4rpx -1rpx rgba(0, 0, 0, 0.06);
}

.shadow-sm {
  box-shadow: 0 1rpx 2rpx 0 rgba(0, 0, 0, 0.05);
}

/* Animations */
.animate-pulse {
  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

.hover-animate-pulse:hover {
  animation: pulse 0.5s cubic-bezier(0.4, 0, 0.6, 1);
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: .7;
  }
}

