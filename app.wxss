/* Tailwind-like utility classes */
/* Background colors - 黑白灰配色方案 */

.bg-white {
  background-color: #ffffff; /* 白色 */
}

.bg-gray-100 {
  background-color: #f5f5f5; /* 浅灰色 */
}

.bg-gray-200 {
  background-color: #e0e0e0; /* 中等浅灰色 */
}

.bg-gray-300 {
  background-color: #cccccc; /* 中等灰色 */
}

.bg-black {
  background-color: #000000; /* 黑色 */
}

.bg-emerald-500 {
  background-color: #000000; /* 黑色 */
}

.bg-emerald-600 {
  background-color: #000000; /* 黑色 */
}

.bg-orange-300 {
